{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mpm group config (mpm.d/<group>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/tag"
      },
      "uniqueItems": true
    },
    "repoName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._][A-Za-z0-9._-]*$",
      "not": {
        "enum": [
          ".",
          "..",
          ".git"
        ]
      }
    },
    "repoRef": {
      "description": "A repo name, 'owner/name', or a full URL.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "repo": {
      "oneOf": [
        {
          "$ref": "#/definitions/repoRef"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "name"
              ]
            },
            {
              "required": [
                "url"
              ]
            }
          ],
          "properties": {
            "name": {
              "$ref": "#/definitions/repoName"
            },
            "url": {
              "$ref": "#/definitions/repoRef"
            },
            "description": {
              "$ref": "#/definitions/text"
            },
            "enabled": {
              "type": "boolean"
            },
            "tags": {
              "$ref": "#/definitions/tags"
            }
          }
        }
      ]
    },
    "text": {
      "description": "A string without control characters.",
      "type": "string",
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    }
  },
  "properties": {
    "title": {
      "$ref": "#/definitions/text"
    },
    "description": {
      "$ref": "#/definitions/text"
    },
    "source": {
      "description": "Base for short repo names: 'github:owner', 'git@host:owner', 'https://host/owner', or a local directory.",
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
    },
    "enabled": {
      "type": "boolean"
    },
    "tags": {
      "$ref": "#/definitions/tags"
    },
    "repos": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/repo"
      }
    }
  }
}
