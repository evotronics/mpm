{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "mpm group config (mpm.d/<group>.yaml)",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "tag": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
    },
    "tags": {
      "type": "array",
      "items": {"$ref": "#/definitions/tag"},
      "uniqueItems": true
    },
    "repoName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._][A-Za-z0-9._-]*$",
      "not": {"enum": [".", ".."]}
    },
    "repoRef": {
      "description": "A repo name, 'owner/name', or a full URL.",
      "type": "string",
      "minLength": 1
    },
    "repo": {
      "oneOf": [
        {"$ref": "#/definitions/repoRef"},
        {
          "type": "object",
          "additionalProperties": false,
          "anyOf": [
            {"required": ["name"]},
            {"required": ["url"]}
          ],
          "properties": {
            "name": {"$ref": "#/definitions/repoName"},
            "url": {"$ref": "#/definitions/repoRef"},
            "description": {"type": "string"},
            "enabled": {"type": "boolean"},
            "tags": {"$ref": "#/definitions/tags"}
          }
        }
      ]
    }
  },
  "properties": {
    "title": {"type": "string"},
    "description": {"type": "string"},
    "source": {
      "description": "Base for short repo names: 'github:owner', 'git@host:owner', 'https://host/owner', or a local directory.",
      "type": "string",
      "minLength": 1
    },
    "enabled": {"type": "boolean"},
    "tags": {"$ref": "#/definitions/tags"},
    "repos": {
      "type": "array",
      "items": {"$ref": "#/definitions/repo"}
    }
  }
}
