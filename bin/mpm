# Author: David I. Lehn <dil@lehn.org>
#

# Run a command.  Handle verbose and dry-run options.
#
# run_cmd cmd [args...]
#
run_cmd()
{
   if [ $VERBOSE = true ]; then
      echo $@
   fi
   if [ $DRYRUN = false ]; then
      $@
      if [ $? -ne 0 ]; then
         echo "ERROR: Command failed $@."
         exit
      fi
   fi
}

# Run a command without failing.  Handle verbose and dry-run options.
#
# run_cmd cmd [args...]
#
run_cmd_no_fail()
{
   if [ $VERBOSE = true ]; then
      echo $@
   fi
   if [ $DRYRUN = false ]; then
      $@ || true
      if [ $? -ne 0 ]; then
         echo "ERROR: Command failed $@."
         exit
      fi
   fi
}

# Update one module.
#
# update_mod MODULE-NAME
#
update_mod()
{
   MOD=$1
   if [ $GIT_GREP != true ]; then
      echo
      echo "=== $MOD ($ROOT/$MOD)..."
   fi
   cd $ROOT

   if [ $CLONE = true ]; then
      if [ ! -d $ROOT/$MOD ]; then
         run_cmd git clone $GITHUB_BASE/$MOD.git
      fi
   fi

   if [ ! -e $ROOT/$MOD ]; then
      echo "ERROR: $ROOT/$MOD not found."
      exit
   fi
   cd $ROOT/$MOD

   if [ $CLEAN = true ]; then
      if [ -d node_modules ]; then
         rm -rf node_modules
      fi
      if [ -d bower_components ]; then
         rm -rf bower_components
      fi
   fi

   if [ $GIT_PULL = true ]; then
      run_cmd git pull
   fi

   if [ $GIT_PUSH = true ]; then
      run_cmd git push
   fi

   if [ $NPM = true ]; then
      echo `pwd`
      if [ -f package.json ]; then
         if [ -d node_modules ]; then
            run_cmd npm update
         else
            run_cmd npm install
         fi
      fi
   fi

   if [ $BOWER = true ]; then
      if [ -f bower.json ]; then
         if [ -d bower_components ]; then
            run_cmd bower update
         else
            run_cmd bower install
         fi
      fi
   fi

   if [ $NPM_REBUILD = true ]; then
      if [ -x package.json ]; then
         DO_REBUILD=true
         for mod in $NO_REBUILD_MODS; do
            if [ $DO_REBUILD = true -a $MOD = $mod ]; then
               DO_REBUILD=false
            fi
         done
         if [ $DO_REBUILD = true ]; then
            run_cmd npm rebuild
         else
            echo "NOTE: Skipping rebuild for '$MOD' module."
         fi
      fi
   fi

   if [ $GIT_STATUS = true ]; then
     run_cmd git status
   fi

   if [ $GIT_DIFF = true ]; then
     run_cmd git diff -p --stat
   fi

   if [ $GIT_DIFFC = true ]; then
     run_cmd git diff -p --cached --stat
   fi

   if [ $GIT_BRANCH = true ]; then
     run_cmd git branch
   fi

   if [ $GIT_PRUNE = true ]; then
     run_cmd git remote prune origin
   fi

   if [ $GIT_PRUNE_N = true ]; then
     run_cmd git remote prune -n origin
   fi

   if [ $GIT_LS_FILES = true ]; then
     run_cmd git ls-files
   fi

   if [ $GIT_SHORTLOG_SEN = true ]; then
     run_cmd git shortlog -s -e -n
   fi

   if [ $TIG = true ]; then
     run_cmd tig
   fi

   if [ $NPM_LS = true ]; then
     run_cmd npm ls
   fi

   if [ $NPM_OUTDATED = true ]; then
     run_cmd npm outdated
   fi

   if [ $BOWER_LS = true ]; then
     run_cmd bower ls
   fi

   if [ $GIT_GREP = true ]; then
     CMD_OUTPUT=`run_cmd_no_fail git grep $GREPARGS`
     if [ "x$CMD_OUTPUT" != "x" ]; then
        echo
        echo "=== $MOD ($ROOT/$MOD)..."
        echo "$CMD_OUTPUT"
     fi
   fi

   if [ $LATEST_TAG = true ]; then
     run_cmd git tag | tail -1
   fi
}

# Update one module.
#
# update_mod MODULE-NAME
#
help()
{
   echo "Usage: $0 [OPTION...] COMMAND [ARGS...]"
   echo "Multiple Project Manager"
   echo
   echo "Options:"
   echo "  -h, --help          Print help."
   echo "  -v, --verbose       Be verbose."
   echo "  -n, --dry-run       Dry-run, don't actually run commands."
   echo "  -m, --module MOD    Module to operate on."
   echo "  -s, --start-mod MOD Module to start on."
   echo
   echo "Commands:"
   echo "  clone        Clone repositories."
   echo "  pull         Run \"git pull\"."
   echo "  push         Run \"git push\"."
   echo "  status       Run \"git status\"."
   echo "  diff         Run \"git diff\"."
   echo "  diffc        Run \"git diff --cached\"."
   echo "  branch       Run \"git branch\"."
   echo "  grep ARGS    Run \"git grep ARGS\"."
   echo "  gc           Run \"git gc\" and show .git dir stats."
   echo "  prune        Run \"git remote prune origin\""
   echo "  prune-n      Run \"git remote prune -n origin\""
   echo "  ls-files     Run \"git ls-files\""
   echo "  shortlog-sen Run \"git shortlog -s -e -n\""
   echo "  tig          Run \"tig\"."
   echo "  clean        Run \"make clean\"."
   echo "  npm          Run \"npm install/update\"."
   echo "  npm-ls       Run \"npm ls\"."
   echo "  npm-outdated Run \"npm outdated\"."
   echo "  npm-rebuild  Run \"npm rebuild\"."
   echo "  bower        Run \"bower install/update\"."
   echo "  bower-ls     Run \"bower ls\"."
   echo "  latest-tag   Show latest tag."
   echo
   echo "Default modules: $MODS"
   echo "All modules: $ALLMODS"
   exit
}

# override before sourcing this file
#ROOT=`dirname $0`
#ROOT=`cd $(dirname $0) && pwd`
#GITHUB_BASE=""
#EXTRA_MODS=""
#CLONE_MODS=""
#DEFAULT_MODS=""
#NO_BUILD_MODS=""
#MODS=""

# options
START_MOD=
VERBOSE=false
DRYRUN=false

# commands
CLONE=false
GIT_PULL=false
GIT_PUSH=false
GIT_STATUS=false
GIT_DIFF=false
GIT_DIFFC=false
GIT_GREP=false
GIT_BRANCH=false
GIT_GC=false
GIT_PRUNE=false
GIT_PRUNE_N=false
GIT_LS_FILES=false
GIT_SHORTLOG_SEN=false
TIG=false
CLEAN=false
NPM=false
NPM_LS=false
NPM_REBUILD=false
NPM_OUTDATED=false
BOWER=false
BOWER_LS=false
LATEST_TAG=false

# process options
while [ $# -gt 0 -a x"${1:0:1}" = x"-" ]; do
   case $1 in
      -h|--help) help ;;
      -v|--verbose) VERBOSE="true" ;;
      -n|--dry-run) DRYRUN="true" ;;
      -m|--module)
         shift
         MODS="$1"
         ;;
      -s|--start-mod) 
         shift
         START_MOD="$1"
         ;;
      *)
         echo "ERROR: Unknown option $1"
         help
         exit
         ;;
   esac
   shift
done

# check for command
if [ $# -lt 1 ]; then
   echo "ERROR: No command given"
   help
   exit
fi

# process command
case $1 in
   clone) CLONE="true"; MODS=$CLONE_MODS ;;
   pull) GIT_PULL="true" ;;
   push) GIT_PUSH="true" ;;
   status) GIT_STATUS="true" ;;
   diff) GIT_DIFF="true" ;;
   diffc) GIT_DIFFC="true" ;;
   grep)
      shift
      GIT_GREP="true"
      GREPARGS="$@"
      ;;
   branch) GIT_BRANCH="true" ;;
   gc) GIT_GC="true" ;;
   prune) GIT_PRUNE="true" ;;
   prune-n) GIT_PRUNE_N="true" ;;
   ls-files) GIT_LS_FILES="true" ;;
   shortlog-sen) GIT_SHORTLOG_SEN="true" ;;
   tig) TIG="true" ;;
   clean) CLEAN="true" ;;
   npm) NPM="true" ;;
   npm-ls) NPM_LS="true" ;;
   npm-outdated) NPM_OUTDATED="true" ;;
   npm-rebuild) NPM_REBUILD="true" ;;
   bower) BOWER="true" ;;
   bower-ls) BOWER_LS="true" ;;
   latest-tag) LATEST_TAG="true" ;;
   *)
      echo "ERROR: Unknown command $1"
      help
      exit
      ;;
esac

if [ $CLONE = true -o \
   $GIT_PULL = true -o \
   $GIT_PUSH = true -o \
   $GIT_STATUS = true -o \
   $GIT_DIFF = true -o \
   $GIT_DIFFC = true -o \
   $GIT_GREP = true -o \
   $GIT_BRANCH = true -o \
   $GIT_PRUNE = true -o \
   $GIT_PRUNE_N = true -o \
   $GIT_LS_FILES = true -o \
   $GIT_SHORTLOG_SEN = true -o \
   $TIG = true -o \
   $NPM = true -o \
   $NPM_LS = true -o \
   $NPM_OUTDATED = true -o \
   $NPM_REBUILD = true -o \
   $BOWER = true -o \
   $BOWER_LS = true -o \
   $LATEST_TAG = true ]; then
   echo "Updating $ROOT/{$MODS}..."
   STARTED=true
   if [ x"$START_MOD" != x ]; then
      STARTED=false
   fi
   for d in $MODS; do
      if [ $STARTED = false -a x"$START_MOD" = x"$d" ]; then
         STARTED=true
      fi
      if [ $STARTED = true ]; then
         update_mod $d
      else
         echo "=== $d [SKIPPED]"
      fi
      if test $? -ne 0; then
         echo "ERROR: Failed to update $d"
         exit 1
      fi
   done
fi

if [ $GIT_GC = true ]; then
   echo "Running \"git gc\" in $ROOT/{$MODS}..."
   GIT_GCDIRS=
   for m in $MODS; do
      GIT_GCDIRS="$GIT_GCDIRS $ROOT/$m/.git"
   done
   echo "Usage before GC..."
   run_cmd du -cs $GIT_GCDIRS
   for m in $MODS; do
      echo "GC $ROOT/$m..."
      (cd $ROOT/$m && run_cmd git gc)
   done
   echo "Usage after GC..."
   run_cmd du -cs $GIT_GCDIRS
fi
